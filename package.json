{
  "name": "ax-clipforge-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "lint": "oxlint .",
    "lint:app": "oxlint src --ignore-pattern \"**/tests/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsc": "tsc --noEmit -p tsconfig.src.json --pretty false",
    "tsc:app": "tsc --noEmit -p tsconfig.no-tests.json --pretty false",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "verify": "bun lint && bun format:check && bun tsc && bun tsc:app && bun run test && bun run fallow:dead",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "allow-scripts": "allow-scripts",
    "check-install-scripts": "node scripts/check-install-scripts.mjs",
    "docker:up": "docker compose up --build",
    "prepare": "husky"
  },
  "author": {
    "name": "Atanu Debbarma",
    "url": "https://github.com/AtanuDebbarma"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "execa": "10.0.1",
    "express": "5.2.1",
    "redis": "6.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.28.5",
    "@lavamoat/allow-scripts": "5.1.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "babel-jest": "29.7.0",
    "fallow": "3.6.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "lavamoat": {
    "allowScripts": {
      "$root$": false
    }
  }
}
