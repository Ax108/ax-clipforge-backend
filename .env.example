# Local development (copy to .env). Cloud origin values are stubs only.
PORT=5000
LISTEN_HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:5000
# Comma-separated allowlist. Do not use *.
# Future hosted frontends (Vercel / Netlify / Render) would be added here.
CORS_ORIGINS=http://localhost:5173,https://YOUR_APP.vercel.app,https://YOUR_APP.netlify.app,https://YOUR_APP.onrender.com
PROXY_URL=
COOKIE_FILE_PATH=
PO_TOKEN=
YTDLP_BIN=yt-dlp
# If `yt-dlp` is not on PATH for the shell running `bun run dev` (common on Windows
# after WinGet until you open a new terminal), set the absolute path to yt-dlp.exe instead.
# Docker images ignore this and use the binary inside the container.
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_TIMEOUT_MS=600000
TMP_MAX_AGE_MS=900000
# Local bun run dev: true (default) keeps cache in ./tmp/cache (no TTL eviction).
# Docker: false = LRU/TTL eviction of cache (files are still reused until evicted).
# Completed extracts are NOT deleted after each download (needed for cache + Range resume).
KEEP_TMP=true
# Optional. Docker Compose sets redis://redis:6379. Empty = in-memory jobs (SSE still works).
REDIS_URL=
JOB_TTL_MS=86400000
CACHE_TTL_MS=86400000
CACHE_MAX_BYTES=2147483648
# Set true when TLS is terminated by a reverse proxy so rate limits use client IP.
TRUST_PROXY=false
# IP rate limits (express-rate-limit). Off automatically when NODE_ENV=test.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_EXTRACT_MAX=10
RATE_LIMIT_FILE_MAX=60
RATE_LIMIT_JOB_READ_MAX=240
# Docker overrides this to /tmp/clipforge so the git checkout is never written.
# TMP_DIR=
